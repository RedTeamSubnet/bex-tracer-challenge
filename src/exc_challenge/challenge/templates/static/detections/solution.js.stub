/**
 * Baseline solution for the extension-classification challenge.
 *
 * This exists so you have something that RUNS and scores above zero. It is not
 * meant to score well - finding the signals is the challenge.
 *
 * ---------------------------------------------------------------- contract --
 * Define `window.detect_extensions` and return one boolean per extension id
 * from GET /task. It may be async; you get a fixed script budget.
 *
 *     window.detect_extensions = async function () {
 *       return { "<extension-id>": true, ... };
 *     };
 *
 * Missing keys count as FALSE, so there is nothing to gain by leaving an id
 * out. The pool is fixed; the enabled subset is redrawn every round.
 *
 * ----------------------------------------------------------------- scoring --
 * MCC over the WHOLE pool, per round, averaged. Two consequences worth
 * internalising before you start guessing:
 *
 *   - True negatives count. A false positive on an extension that was off
 *     costs you real score. Answering "true" for everything scores 0.0, not
 *     0.5, because an all-one-class answer carries no information.
 *   - The number enabled changes per round, so you cannot assume a fixed count.
 *
 * Where you are unsure, false is usually the better bet.
 *
 * --------------------------------------------------------- where to look ----
 * Two techniques are demonstrated below. Neither is complete.
 *
 *   1. web_accessible_resources - an extension can expose files to the page.
 *      If it does, `fetch("chrome-extension://<id>/<path>")` resolves when the
 *      extension is installed and rejects when it is not. This is the most
 *      reliable signal available, but you have to find the paths yourself:
 *
 *        - download the .crx, unzip it, read `web_accessible_resources` in
 *          manifest.json
 *        - a manifest glob (src/images/*.png) is NOT fetchable - you need a
 *          real file that actually ships in the package
 *        - a path the manifest declares but the extension does not ship 404s
 *        - `use_dynamic_url: true` puts resources behind a per-session GUID
 *          that page JS cannot enumerate. Those extensions need another angle.
 *
 *      Roughly two thirds of the pool is reachable this way. The rest is not.
 *
 *   2. Page footprint - some extensions rewrite the DOM, inject stylesheets,
 *      stamp attributes, or attach shadow roots. Compare what you see against
 *      the page as it was served.
 *
 * Other angles that are NOT demonstrated here, and are where the remaining
 * score lives:
 *
 *   - declarativeNetRequest: content blockers cancel ad and tracker requests
 *     before they hit the network. Different blockers ship different rule
 *     sets, so *which* hosts die is a fingerprint. Watch out - if the host has
 *     no egress at all, everything looks blocked. Use a control request.
 *   - timing: some extensions measurably delay first paint or a given fetch
 *   - user gestures: password managers often inject nothing until there is a
 *     real interaction with the field they care about
 *   - CSS: injected rules change getComputedStyle results on elements you own
 *
 * A handful of extensions in the pool have no observable footprint at all on a
 * page like this one. Returning false for those is correct, not lazy.
 */
window.detect_extensions = async function () {
  // Answer for every id the challenge publishes.
  const POOL = [
    "cfhdojbkjhnklbpkdaibdccddilifddb", // Adblock Plus
    "mlomiejdfkolichcflejclcbmpeaniij", // Ghostery
    "pkehgijcmpdhfbdbbnkijodmdjhbjlgp", // Privacy Badger
    "bkdgflcldnnnapblkhphbgpggdiikppg", // DuckDuckGo Privacy Essentials
    "nngceckbapebfimnlniiiahkandclblb", // Bitwarden
    "hdokiejnpimakedhajhdlcegeplioahd", // LastPass
    "aeblfdkhhhdcdjpifhhbdiojplfjncoa", // 1Password
    "fdjamakpfbbddfjaooikfcpapjohcfmg", // Dashlane
    "fooolghllnmhmmndgjiamiiodkpenpbb", // NordPass
    "bmnlcjabgnpnenekpadlanbbkooimhnj", // Honey
    "nenlahapcbofgnanklpelkaejcehkggg", // Capital One Shopping
    "chhjbpecpncaggjpdakmflnfcopglcmi", // Rakuten
    "kbfnbcaeplbcioakkpcpgfkobkghlhen", // Grammarly
    "npnbdojkgkbcdfdjlfdmplppdphlhhcf", // ProWritingAid
    "oldceeleldhonbafppcapldpdifcinji", // LanguageTool
    "eimadpbcbfnmbkopoojfekhnkhdbieeh", // Dark Reader
    "bfbmjmiodbnnpllbbbfblcplfjjepjdn", // Turn Off the Lights
    "aapbdbdomjkkjkaonfhkkikfgjllcleb", // Google Translate
    "bpoadfkcbjbfhfodiogcnhhhpibjhbnh", // Immersive Translate
    "pioclpoplcdbaefihamjohnefbikjilc", // Evernote Web Clipper
    "knheggckgoiihginacbkhaalnibhilkk", // Notion Web Clipper
    "bcjindcccaagfpapjjmafapmmgkkhgoa", // JSON Formatter
    "bhlhnicpbhignbdhedgjhgdocnmhomnp", // ColorZilla
    "gppongmhjkpfnbhagpmjfkannfbllamg", // Wappalyzer
    "lmjnegcaeklhafolokijcfjliaokphfk", // Video DownloadHelper
    "liecbddmkiiihnedobmlmillhodjkdmb", // Loom
    "oeopbcgkkoapgobdbedcemjljbihmemj", // Checker Plus for Gmail
  ];

  const result = {};
  for (const id of POOL) result[id] = false;

  // -- technique 1: web_accessible_resources ---------------------------------
  // Three worked examples so you can see the shape. The other WAR-reachable
  // extensions in the pool are yours to find - read their manifests.
  const WAR_PROBES = {
    kbfnbcaeplbcioakkpcpgfkobkghlhen: // Grammarly
      "src/fonts/056faeebcd17e8bb/inter_Inter-MediumItalic.woff",
    aapbdbdomjkkjkaonfhkkikfgjllcleb: "popup_css_compiled.css", // Google Translate
    gppongmhjkpfnbhagpmjfkannfbllamg: "js/js.js", // Wappalyzer
  };

  // A chrome-extension:// URL for an extension that is not installed rejects
  // rather than returning a status, so a throw is a negative, not an error.
  const warProbe = async (id, path) => {
    try {
      const res = await fetch(`chrome-extension://${id}/${path}`, {
        method: "GET",
        cache: "no-store",
      });
      return res.ok;
    } catch (_) {
      return false;
    }
  };

  const ids = Object.keys(WAR_PROBES);
  const hits = await Promise.all(ids.map((id) => warProbe(id, WAR_PROBES[id])));
  ids.forEach((id, i) => {
    result[id] = hits[i];
  });

  // -- technique 2: page footprint -------------------------------------------
  // Dark Reader recolours the page and stamps <html> on its way in. Most
  // extensions are far subtler than this; some leave nothing at all.
  const darkReaderPresent =
    document.documentElement.hasAttribute("data-darkreader-mode") ||
    document.querySelector("style.darkreader, .darkreader") !== null;
  result["eimadpbcbfnmbkopoojfekhnkhdbieeh"] = darkReaderPresent;

  // Everything else stays false. That is the honest answer until you have a
  // signal - and with MCC, an honest false beats a hopeful true.
  return result;
};
